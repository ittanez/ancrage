<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AncrAge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Theme du Splash Screen avec animation -->
    <style name="Theme.AncrAge.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_purple</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_background</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.AncrAge</item>
    </style>
</resources>
