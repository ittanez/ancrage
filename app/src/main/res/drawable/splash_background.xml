<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fond dégradé violet apaisant -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#9370DB"
                android:centerColor="#B19CD9"
                android:endColor="#D8BFD8"
                android:type="linear" />
        </shape>
    </item>

    <!-- Logo centré (cercles concentriques) -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>

    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#9370DB" />
            <size
                android:width="100dp"
                android:height="100dp" />
        </shape>
    </item>

    <item
        android:width="80dp"
        android:height="80dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="80dp"
                android:height="80dp" />
        </shape>
    </item>

    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#9370DB" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
</layer-list>
